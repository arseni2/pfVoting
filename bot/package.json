{
  "name": "bot",
  "version": "1.0.0",
  "description": "Telegram bot for pfVoting",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "seed": "tsx prisma/seed.ts",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "telegram",
    "bot",
    "telegraf"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "dotenv": "^17.3.1",
    "http-proxy-agent": "^8.0.0",
    "https-proxy-agent": "^8.0.0",
    "mtprotoproxy": "^2.0.0",
    "socks-proxy-agent": "^9.0.0",
    "socks5-https-client": "^1.2.1",
    "telegraf": "^4.16.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.4.0",
    "eslint": "^10.0.3",
    "globals": "^17.4.0",
    "prettier": "3.8.1",
    "prisma": "^7.5.0",
    "tsc-alias": "^1.8.16",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.0.18"
  }
}
