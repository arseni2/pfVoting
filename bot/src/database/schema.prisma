generator client {
  provider = "prisma-client-js"
  output   = "../src/database"
}

datasource db {
  provider = "sqlite"
}

model User {
  id         Int      @id @default(autoincrement())
  tg_id      Int      @unique
  username   String?
  first_name String?
  chat_id    String?
  last_name  String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  rooms_created Room[]        @relation("RoomCreator")
  memberships   RoomMember[]  @relation("UserToRoomMember")
  orders        Order[]
  voteSessions  VoteSession[] @relation("VoteSessionCreator")
  votes         Vote[]

  @@index([tg_id])
}

model Room {
  id         Int       @id @default(autoincrement())
  name       String
  creator_id Int
  is_active  Boolean   @default(true)
  deleted_at DateTime?
  deleted_by Int?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  creator       User          @relation("RoomCreator", fields: [creator_id], references: [id])
  roomMembers   RoomMember[]  @relation("RoomToRoomMember")
  orders        Order[]
  vote_sessions VoteSession[]

  @@index([is_active])
  @@index([creator_id])
  @@index([created_at])
}

model RoomMember {
  id        Int       @id @default(autoincrement())
  room_id   Int
  user_id   Int
  joined_at DateTime  @default(now())
  left_at   DateTime?
  is_active Boolean   @default(true)

  room Room @relation("RoomToRoomMember", fields: [room_id], references: [id], onDelete: Cascade)
  user User @relation("UserToRoomMember", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([room_id, user_id])
  @@index([room_id])
  @@index([user_id])
  @@index([is_active])
}

model Order {
  id         Int      @id @default(autoincrement())
  room_id    Int
  user_id    Int
  pizza_name String
  addons     String?
  comment    String?
  quantity   Int      @default(1)
  is_deleted Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  room Room @relation(fields: [room_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id])

  @@index([room_id])
  @@index([user_id])
  @@index([is_deleted])
  @@index([created_at])
  @@index([room_id, is_deleted])
}

model VoteSession {
  id                    Int        @id @default(autoincrement())
  room_id               Int
  user_creator_id       Int
  started_at            DateTime   @default(now())
  completed_at          DateTime?
  status                VoteStatus @default(ACTIVE)
  participants_snapshot Json
  telegram_poll_id      String?
  telegram_message_id   Int?
  telegram_chat_id      String?
  options_snapshot      Json?
  is_deleted            Boolean    @default(false)
  created_at            DateTime   @default(now())
  updated_at            DateTime   @updatedAt

  room    Room   @relation(fields: [room_id], references: [id], onDelete: Cascade)
  creator User   @relation("VoteSessionCreator", fields: [user_creator_id], references: [id])
  votes   Vote[]

  @@index([room_id])
  @@index([status])
  @@index([user_creator_id])
  @@index([is_deleted])
  @@index([started_at])
}

model Vote {
  id           Int      @id @default(autoincrement())
  session_id   Int
  user_id      Int
  option_index Int
  created_at   DateTime @default(now())

  session VoteSession @relation(fields: [session_id], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([session_id, user_id, option_index])
  @@index([session_id])
  @@index([user_id])
}

enum VoteStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}
